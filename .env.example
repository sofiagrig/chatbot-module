# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.

# Database: the shared Supabase project (dental-branch-directory), restricted role chatbot_app.
# Supabase > Project Settings > Database > Connection string > Transaction pooler,
# user chatbot_app.<project-ref>, the password set with `alter role chatbot_app ...`.
CHATBOT_DATABASE_URL=postgresql://chatbot_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Claude API key (Claude Console > API keys). Server only.
ANTHROPIC_API_KEY=
# Model for answers and for reading uploaded PDFs.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Cloudflare Access: the team domain (<team>.cloudflareaccess.com) and the Application
# Audience (AUD) tag of the Access application that protects bot.shinaim.biz.
CF_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_ACCESS_AUD=

# Production address. On Vercel production, requests to *.vercel.app redirect here.
CANONICAL_HOST=bot.shinaim.biz

# Comma-separated admin emails (more can be added in the chatbot.roles table).
BOOTSTRAP_ADMIN_EMAILS=sofya@shinaim.biz

# Israeli VAT rate used when adding VAT to price-list totals.
VAT_RATE=0.18

# Local development only (`npm run dev`): act as this user without Cloudflare Access.
# Ignored in production builds.
DEV_USER_EMAIL=
